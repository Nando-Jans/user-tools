{% extends 'layout/auth.html.twig' %}
{% block body %}
    <h1>2FA code</h1>
    {% if authenticationError %}<div class="alert alert-danger">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</div>{% endif %}
    <form class="form" action="{{ checkPathRoute ? path(checkPathRoute) : checkPathUrl }}" method="post">
        <p>Haal de 2FA code uit je <strong>google authenticator</strong> app en vul deze hieronder in.</p>
        <input class="form-control" type="text" name="{{ authCodeParameterName }}" autocomplete="one-time-code" inputmode="numeric" autofocus>
        {% if displayTrustedOption %}<label><input type="checkbox" name="{{ trustedParameterName }}"> {{ 'trusted'|trans({}, 'SchebTwoFactorBundle') }}</label>{% endif %}
        <button class="btn-app btn-app-primary w-100" type="submit">Login</button>
    </form>
{% endblock %}
