{
    "name": "nando-jans/user-tools",
    "version": "1.2.1",
    "description": "Reusable user tools for Symfony",
    "type": "symfony-bundle",
    "keywords": ["symfony-ux"],
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "NandoJans\\UserTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NandoJans\\UserTools\\Tests\\": "tests/"
        }
    },
    "require": {
        "endroid/qr-code": "^6.0",
        "php": "^8.5",
        "scheb/2fa-bundle": "^8.0",
        "scheb/2fa-google-authenticator": "^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/mailer": "^7.4 || ^8.0",
        "symfony/mime": "^7.4 || ^8.0",
        "symfony/options-resolver": "^7.4 || ^8.0",
        "symfony/property-access": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/stimulus-bundle": "^2.9 || ^3.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/framework-bundle": "8.0.*",
        "symfony/validator": "^8.0",
        "symfony/orm-pack": "^2.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/maker-bundle": "^1.67",
        "symfony/security": "^2.0"
    }
}
